    <!-- Ayuda -->
    <string name="help_intro">Respuestas a las preguntas más comunes.</string>
    <string name="help_faq_offline_q">¿Puedo usar la app sin señal?</string>
    <string name="help_faq_offline_a">Sí. Las inspecciones, cosechas y cambios de stock se guardan en el teléfono y se sincronizan solos cuando vuelves a tener conexión.</string>
    <string name="help_faq_reject_q">¿Qué hago si rechazan un lote?</string>
    <string name="help_faq_reject_a">Abre el reporte desde Pedidos o Reportes, revisa el motivo y usa Reinspeccionar después de reclasificar el lote.</string>
    <string name="help_faq_payments_q">¿Cuándo me pagan?</string>
    <string name="help_faq_payments_a">Las liquidaciones aparecen en Liquidaciones con su fecha. Recibirás una notificación cuando se realice un pago.</string>
    <string name="help_faq_language_q">¿Cómo cambio el idioma?</string>
    <string name="help_faq_language_a">Toca EN o ES en la barra superior, o entra a Mi cuenta → Idioma.</string>
    <string name="help_contact_title">Contactar a soporte</string>
    <string name="help_contact_desc">Escribe a tu distribuidor desde Mensajes o contacta al equipo de FruitLogix.</string>
