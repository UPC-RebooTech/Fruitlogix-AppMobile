    <!-- Help -->
    <string name="help_intro">Answers to the most common questions.</string>
    <string name="help_faq_offline_q">Can I use the app without signal?</string>
    <string name="help_faq_offline_a">Yes. Inspections, harvests and stock updates are saved on the phone and sync automatically when you are back online.</string>
    <string name="help_faq_reject_q">What do I do if a lot is rejected?</string>
    <string name="help_faq_reject_a">Open the report from Orders or Reports, check the reason and use Re-inspect after re-grading the lot.</string>
    <string name="help_faq_payments_q">When do I get paid?</string>
    <string name="help_faq_payments_a">Payouts are listed in Payouts with their due date. You will get a notification when a payment is made.</string>
    <string name="help_faq_language_q">How do I change the language?</string>
    <string name="help_faq_language_a">Tap EN or ES in the top bar, or go to My account → Language.</string>
    <string name="help_contact_title">Contact support</string>
    <string name="help_contact_desc">Write to your distributor from Messages or contact the FruitLogix team.</string>
